# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# База данных (SQLite по умолчанию или PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///pilot_tenders.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opportunity_pilot

# Настройки LLM (Polza.ai / OpenAI)
OPENAI_API_KEY=your_polza_or_openai_api_key_here
OPENAI_BASE_URL=https://polza.ai/api/v1
OPENAI_MODEL=openai/gpt-5.6-luna
